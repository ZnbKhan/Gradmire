-    --coral: 12 88% 47%;
+    /* ---- Brand tokens ----
+     * Re-themed to the approved visual identity (navy #11446A / sky blue
+     * #298DC6 / white / black). Token names are unchanged on purpose —
+     * every component already reads --ink and --coral, so repointing the
+     * values here re-skins the whole app without touching each file.
+     */
+    --ink: 206 72% 13%;
+    --ink-2: 206 70% 22%;
+    --ink-3: 206 55% 32%;
+    --paper: 205 30% 97%;
+    --paper-dim: 205 24% 93%;
+    --line: 205 20% 85%;
+
+    /* "coral" now carries the brand sky blue (#298DC6). */
+    --coral: 202 66% 47%;
     /*
-     * Coral at #E4390E scores 4.11:1 on paper and 4.29:1 behind white
-     * button text — both below the 4.5:1 AA floor, and it is used almost
-     * entirely at 11–13px. This darker cut clears AA; the brighter one is
-     * reserved for large display type and decorative fills.
+     * Sky blue at #298DC6 scores 3.67:1 on white — below the 4.5:1 AA
+     * floor for normal text. This darker cut (~#1c6087) clears AA; the
+     * brighter one is reserved for large display type, icons, and
+     * decorative fills.
      */
-    --coral-text: 13 95% 37%;
-    --coral-dim: 17 90% 92%;
+    --coral-text: 202 66% 32%;
+    --coral-dim: 202 55% 92%;
 
     --gold: 42 63% 48%;
     --brand-green: 160 61% 27%;
     --brand-green-dim: 148 32% 90%;
 
-    --ink-soft: 232 20% 38%;
+    --ink-soft: 206 22% 40%;
 
     /* Perforation fill for boarding-pass cards. Each section that hosts a
        pass overrides this to its own background so the notches read as holes. */
@@ -69,14 +75,14 @@
   }
 
   .dark {
-    --paper: 232 40% 9%;
-    --paper-dim: 233 38% 13%;
-    --line: 233 25% 24%;
-    --ink: 45 30% 96%;
-    --ink-soft: 235 15% 68%;
-    --coral: 12 88% 60%;
-    --coral-text: 12 90% 68%;
-    --coral-dim: 12 40% 20%;
+    --paper: 206 40% 8%;
+    --paper-dim: 206 36% 12%;
+    --line: 206 25% 22%;
+    --ink: 205 35% 95%;
+    --ink-soft: 205 15% 68%;
+    --coral: 202 70% 62%;
+    --coral-text: 202 75% 72%;
+    --coral-dim: 202 45% 20%;
     --gold: 42 70% 62%;
     --brand-green: 160 45% 45%;
     --brand-green-dim: 160 30% 18%;
@@ -116,10 +122,20 @@
   }
 
   h1, h2, h3, h4 {
-    @apply font-display tracking-tight;
+    @apply font-display;
     text-wrap: balance;
   }
 
+  /* Tracking is size-specific: large display type needs negative tracking
+     as it grows, small card headings (h3/h4, ~17–23px) read as cramped
+     with the same value, so they get a much lighter touch. */
+  h1, h2 {
+    @apply tracking-tight;
+  }
+  h3, h4 {
+    letter-spacing: -0.005em;
+  }
+
   /*
    * The prototype shipped with no focus styles at all. This is the floor:
    * every interactive element gets a visible ring, keyboard-only.
@@ -133,6 +149,16 @@
   table, .tabular {
     font-variant-numeric: tabular-nums;
   }
+
+  /*
+   * Every pill CTA (hero, footer, header) responds on press, not just
+   * on hover — hover never fires on touch, so without this a tap gave
+   * zero feedback until the page navigated.
+   */
+  a[class*="rounded-pill"]:active,
+  button[class*="rounded-pill"]:active {
+    transform: scale(0.97) translateY(0);
+  }
 }
 
